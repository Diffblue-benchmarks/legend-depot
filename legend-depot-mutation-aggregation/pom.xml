        </dependency>
        <dependency>
            <groupId>org.finos.legend.depot</groupId>
            <artifactId>legend-depot-artifacts-repository-maven-impl</artifactId>
            <version>2.65.1-SNAPSHOT</version>
        </dependency>
        <dependency>
