            <artifactId>legend-depot-model</artifactId>
            <version>2.65.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.finos.legend.depot</groupId>
            <artifactId>legend-depot-pure-model-context</artifactId>
            <version>2.65.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.finos.legend.depot</groupId>
